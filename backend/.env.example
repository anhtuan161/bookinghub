# ====== Chế độ chạy ======
# DEMO_MODE=true  → chạy bằng dữ liệu mẫu trong bộ nhớ, KHÔNG cần Google/Claude.
#                   (mặc định — để chạy local ngay và nối frontend)
# DEMO_MODE=false → đọc Google Sheet thật + dùng Claude bóc tách.
DEMO_MODE=true

PORT=8787

# ====== Supabase Postgres (chuỗi Session pooler, IPv4) ======
DATABASE_URL=

# ====== Auth (để trống = API mở; bật khi sẵn sàng) ======
AUTH_REQUIRED=false
# Supabase → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ====== Google Sheets (chỉ cần khi DEMO_MODE=false) ======
# JSON của Service Account (1 dòng), hoặc dùng GOOGLE_SERVICE_ACCOUNT_FILE trỏ tới file .json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ====== AI bóc tách (chỉ cần khi DEMO_MODE=false) ======
# Chọn nhà cung cấp: gemini (FREE) | anthropic (Claude) | openrouter
LLM_PROVIDER=gemini

# -- Gemini (Google AI Studio: ai.google.dev) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -- Anthropic (Claude) --
ANTHROPIC_API_KEY=
#   - claude-sonnet-4-6  : $3 / $15 mỗi 1M token
#   - claude-haiku-4-5   : $1 / $5  mỗi 1M token (rẻ hơn)
LLM_MODEL=claude-sonnet-4-6

# -- OpenRouter (openrouter.ai) — tương thích OpenAI --
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# -- Giãn nhịp gọi LLM (tránh 429) --
LLM_MIN_INTERVAL_MS=4000    # khoảng cách tối thiểu giữa 2 request (4000 ~ 15 req/phút)
LLM_MAX_RETRIES=3           # số lần retry khi 429 (exponential backoff)

# ====== Đồng bộ ======
SYNC_INTERVAL_MINUTES=2     # cron chạy mỗi N phút (queue-drain)
SYNC_BATCH_SIZE=2           # mỗi lần xử lý tối đa N sheet "cũ nhất"
SYNC_WINDOW_MONTHS=6        # chỉ đọc từ tháng hiện tại + N tháng tới
REVIEW_CONFIDENCE=0.8       # dưới ngưỡng này → đẩy vào hàng "Cần kiểm tra"
DATA_STALE_MINUTES=120      # quá N phút chưa sync → cảnh báo dữ liệu cũ
