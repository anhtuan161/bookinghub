# Để trống → frontend chạy bằng dữ liệu mẫu (mock), không cần backend.
# Đặt giá trị → frontend gọi backend thật.
#   - Chạy local:   VITE_API_URL=http://localhost:8787/api
#   - Trên Vercel:  đặt biến này trong Project Settings → Environment Variables,
#                   trỏ tới URL backend đã deploy (vd https://api.bookinghub.xxx/api)
VITE_API_URL=
